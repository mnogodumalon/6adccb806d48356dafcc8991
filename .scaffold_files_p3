            <la-nav-section type="primary" label={t('data_management')} icon="IconMenu2" dense="">
              <la-app-group-nav-widget group-id={APPGROUP_ID} />
            </la-nav-section>
          </la-nav-section>

          {/* Abläufe — a section like the platform's own lists: one row per
